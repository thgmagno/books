# PostgreSQL (Railway fornece automaticamente ao adicionar o plugin Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/book_notes_db

# NextAuth v5 — gere com: npx auth secret
AUTH_SECRET=

# Google OAuth (console.cloud.google.com → Credentials → OAuth 2.0 Client ID)
# Redirect URI: https://SEU-DOMINIO/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Em produção no Railway, defina também:
# AUTH_TRUST_HOST=true
